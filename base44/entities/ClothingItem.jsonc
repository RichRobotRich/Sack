        "114",
        "4XL"
      ],
      "description": "Gr\u00f6\u00dfe"
    },
    "current_stock": {
      "type": "number",
      "default": 0,
      "description": "Aktueller Bestand"
    },
    "minimum_stock": {
      "type": "number",
      "default": 0,
      "description": "Mindestbestand"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Aktiv"
    },
    "is_used": {
      "type": "boolean",
      "default": false,
      "description": "Gebrauchte Kleidung"
    }
