      "type": "string",
      "description": "Artikel-ID"
    },
    "article_name": {
      "type": "string",
      "description": "Artikelbezeichnung"
    },
    "size": {
      "type": "string",
      "description": "Gr\u00f6\u00dfe"
    },
    "quantity": {
      "type": "number",
      "description": "Ausgegebene Menge"
    },
    "request_date": {
      "type": "string",
      "format": "date",
      "description": "Anfragedatum"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Ausgabedatum"
    },
    "request_id": {
      "type": "string",
